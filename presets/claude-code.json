{
  "name": "claude-code",
  "version": "1.0.0",
  "description": "Extracts session-unique volatile bytes from Claude Code requests (scratchpad paths, session URLs, session-id metadata) so the stable prefix hashes identically across sessions.",
  "extractors": [
    {
      "id": "scratchpad-uuid-path",
      "path": "system[*].text",
      "pattern": "scratchpad/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    },
    {
      "id": "session-id-metadata",
      "path": "system[*].text",
      "pattern": "session-id:\\s*[0-9a-f-]{36}"
    },
    {
      "id": "tool-session-url",
      "path": "tools[*].description",
      "pattern": "https://claude\\.ai/code/session_[A-Za-z0-9_-]+"
    }
  ]
}
