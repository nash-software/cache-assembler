{
  "name": "cache-assembler",
  "version": "0.1.0",
  "private": false,
  "description": "Rewrites Anthropic Messages API requests for maximal prompt-cache reuse",
  "license": "MIT",
  "author": "Michael Nash (https://nashsoftware.dev)",
  "homepage": "https://github.com/nash-software/cache-assembler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nash-software/cache-assembler.git"
  },
  "bugs": {
    "url": "https://github.com/nash-software/cache-assembler/issues"
  },
  "keywords": [
    "anthropic",
    "claude",
    "prompt-caching",
    "llm",
    "proxy",
    "cost-optimization",
    "agents"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cache-assembler": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": ["dist", "presets", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run type-check && npm run test:unit && npm run build",
    "e2e:synthetic": "tsx test/e2e/synthetic/run-synthetic.ts",
    "e2e:report": "tsx test/e2e/report/build-report.ts",
    "e2e:real": "tsx test/e2e/real-cli/run-real-cli.ts",
    "e2e:package": "tsx test/e2e/package/verify-package.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.17.10",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
